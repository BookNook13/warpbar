:root {
  color-scheme: dark;
}

.palette-root {
  display: flex;
  justify-content: center;
  padding-top: 8vh;
  height: 100vh;
  background: #1a1b1e;
  font-family: -apple-system, "Inter", sans-serif;
}

.palette-shell {
  width: 640px;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background: #232427;
  border: 1px solid #333;
  border-radius: 12px;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.palette-input {
  background: transparent;
  border: none;
  outline: none;
  color: #f2f2f2;
  font-size: 18px;
  padding: 18px 20px;
  border-bottom: 1px solid #333;
}

.palette-status {
  padding: 6px 20px;
  font-size: 12px;
  color: #777;
}

.palette-list {
  list-style: none;
  margin: 0;
  padding: 4px;
  overflow-y: auto;
}

.palette-item {
  display: flex;
  justify-content: space-between;
  padding: 10px 14px;
  border-radius: 8px;
  color: #ddd;
  cursor: pointer;
}

.palette-item.selected {
  background: #3a3d8f;
  color: #fff;
}

.item-subtitle {
  color: #999;
  font-size: 12px;
}

.output-panel {
  border-top: 1px solid #333;
  padding: 12px 20px;
  font-size: 13px;
  max-height: 220px;
  overflow-y: auto;
}

.output-stdout {
  color: #b5f5b5;
  white-space: pre-wrap;
}

.output-stderr {
  color: #f5a3a3;
  white-space: pre-wrap;
}

.output-meta {
  color: #888;
  margin-bottom: 6px;
}
