{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dev-flow",
  "version": "0.1.0",
  "identifier": "com.kapo.dev-flow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevFlow",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A high-performance developer command palette",
    "longDescription": "DevFlow is a fast, keyboard-driven command palette for developers on Linux — search, run, and manage custom shell commands without leaving the keyboard.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
